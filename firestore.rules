rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /programApplications/{applicationId} {
      allow create: if request.resource.data.keys().hasAll([
        'programId', 'programTitle', 'name', 'phone', 'paymentStatus', 'createdAt'
      ]);
      allow read, update, delete: if isAdmin();
    }

    match /spaceReservations/{reservationId} {
      allow create: if request.resource.data.keys().hasAll([
        'name', 'phone', 'date', 'time', 'people', 'status', 'createdAt'
      ]);
      allow read, update, delete: if isAdmin();
    }

    match /bookClubApplications/{applicationId} {
      allow create: if request.resource.data.keys().hasAll([
        'bookIds', 'name', 'phone', 'paymentStatus', 'createdAt'
      ]);
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
